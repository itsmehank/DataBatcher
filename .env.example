# Copy this file to .env and adjust values for local development or CI
# IMPORTANT: Do not commit real credentials. Keep .env local-only.
PROJECT_NAME=mysql-standalone
TZ=Asia/Seoul

MYSQL_ROOT_PASSWORD=YOUR_ROOT_PASSWORD
MYSQL_DATABASE=trade
MYSQL_USER=YOUR_DB_USER
MYSQL_PASSWORD=YOUR_DB_PASSWORD
MYSQL_PORT=3306

MONGO_PROJECT_NAME=mongo-standalone
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_MONGO_ROOT_PASSWORD
MONGO_APP_DB_NAME=insight_archive
MONGO_APP_USERNAME=insight_app
MONGO_APP_PASSWORD=CHANGE_ME_MONGO_APP_PASSWORD

REAL_ESTATE_DB_NAME=real_estate
REAL_ESTATE_TEST_DB_NAME=real_estate_test
REAL_ESTATE_DB_USER=YOUR_RE_DB_USER
REAL_ESTATE_DB_PASSWORD=YOUR_RE_DB_PASSWORD

# Preferred: override database URL used by the app via env var.
# All scripts load .env automatically (python-dotenv) and core/config_loader.py gives DATABASE_URL top priority.
# Never put real credential values in docs/examples.
DATABASE_URL=mysql+pymysql://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:3306/trade?charset=utf8mb4
