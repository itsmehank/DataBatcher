# DB (ingest-databatcher와 동일 DB 사용)
DATABASE_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/trade?charset=utf8mb4

# Anthropic API 키 — API 백엔드 사용 시 필수, CLI 모드에서는 선택 (ADR-011)
ANTHROPIC_API_KEY=

# Claude Code CLI는 Max 플랜 로그인 상태 그대로 사용 — 별도 환경 변수 없음

# ── Phase 2 Sprint 2 — SMTP 발송 자격증명 ───────────────────────────────────
# Gmail 사용 시: 2-Step Verification 활성화 후
# https://myaccount.google.com/apppasswords 에서 16자리 앱 비밀번호 발급(공백 제외)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=your.email@gmail.com
SMTP_TO_DEFAULT=your.email@gmail.com
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
