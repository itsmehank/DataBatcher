# --- Stack ---
INSIGHT_ARCHIVE_STACK=insight-archive

# --- Server ---
BACKEND_PORT=4000
FRONTEND_PORT=3000
NODE_ENV=development

# --- Backend Runtime ---
# Docker app stack -> shared Mongo on the shared Docker network
MONGODB_URI=mongodb://insight_app:change-this-app-password@shared-mongo:27017/insight_archive?authSource=insight_archive
# Local non-Docker backend example:
# MONGODB_URI=mongodb://insight_app:change-this-app-password@127.0.0.1:27017/insight_archive?authSource=insight_archive
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=7d
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
BACKUP_DIR=/app/backups
BACKUP_FILE_NAME=latest.archive.gz

# --- Security ---
CORS_ORIGIN=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
