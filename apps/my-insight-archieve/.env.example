# --- MongoDB Root (초기화 전용, 운영 시 강력한 비밀번호로 변경 필수) ---
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=adminpassword
MONGO_DB=insight_archive
INSIGHT_ARCHIVE_STACK=insight-archive

# --- MongoDB App User (앱이 실제 사용하는 계정, readWrite 권한만 부여) ---
MONGO_APP_USERNAME=insight_app
MONGO_APP_PASSWORD=change-this-app-password

# --- Server ---
BACKEND_PORT=4000
FRONTEND_PORT=3000
NODE_ENV=development

# --- Backend ---
MONGODB_URI=mongodb://insight_app:change-this-app-password@mongodb:27017/insight_archive?authSource=insight_archive
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=7d
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
BACKUP_DIR=/app/backups
BACKUP_FILE_NAME=latest.archive.gz

# --- Security ---
CORS_ORIGIN=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
