# 로컬 프로세스(비-Docker) 실행 예시
DATABASE_URL=mysql+pymysql://<db_user>:<db_password>@127.0.0.1:3306/<db_name>?charset=utf8mb4
# Docker 백엔드 컨테이너에서 호스트 MySQL 접속 예시
# DATABASE_URL=mysql+pymysql://<db_user>:<db_password>@host.docker.internal:3306/<db_name>?charset=utf8mb4
ALLOWED_ORIGINS=http://localhost:5173
STARTUP_DB_CHECK=true
BACKEND_PORT=8000
FRONTEND_PORT=5173
# --- Auth ---
SECRET_KEY=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=false
# Startup admin bootstrap (optional)
# Both values must be set together. Bootstrap runs only when STARTUP_DB_CHECK=true.
ADMIN_USERNAME=
ADMIN_PASSWORD=
