# Copy to apps/trading-view-project/ops/scheduler/windows/scheduler.env and fill real values.
# WARNING: scheduler.env must never be committed.

# Git Bash executable used to run the shared .sh wrapper.
GIT_BASH_EXE=C:\Program Files\Git\bin\bash.exe

# Node executable used by run_dashboard_download.sh.
NODE_BIN=C:\Program Files\nodejs\node.exe

# Frontend URL that proxies /api/* to backend.
FRONTEND_URL=http://127.0.0.1:5173

# Dashboard query defaults.
REGION=US
MARKET=NASDAQ
LIST_CATEGORY=all

# Optional fixed date. Leave blank to use dashboard default latest date.
DATE=

# Headless browser execution.
HEADLESS=true

# Optional custom output directory for ZIP downloads.
# OUTPUT_DIR=C:\Users\YOUR_USER\PythonProject\DataBatcher\apps\trading-view-project\automation\output
