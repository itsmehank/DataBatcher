# Copy to scheduler/windows/scheduler.env and fill real values.
# WARNING: scheduler.env must never be committed.

# Python executable used for Apprise notifications
SCHEDULER_PYTHON_EXE=C:\\Users\\YOUR_USER\\PythonProject\\DataBatcher\\.venv\\Scripts\\python.exe

# Git Bash executable (required in this scheduler design)
GIT_BASH_EXE=C:\\Program Files\\Git\\bin\\bash.exe

# Docker container name from docker/docker-compose.yml
DOCKER_MYSQL_CONTAINER=databatche_db

# Optional: force DB target for scheduler runs.
# If set, it overrides config/settings*.yaml via app config precedence.
# DATABASE_URL=mysql+pymysql://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:3306/market?charset=utf8mb4

# Log retention days for logs/scheduler/*.log
LOG_RETENTION_DAYS=14

# Multiple channels supported with ';' separator.
# Telegram example:
# APPRISE_URLS=tgram://BOT_TOKEN/CHAT_ID
# Telegram + Mail example:
# APPRISE_URLS=tgram://BOT_TOKEN/CHAT_ID;mailto://user:password@smtp.gmail.com:587/to@example.com
APPRISE_URLS=tgram://YOUR_BOT_TOKEN/YOUR_CHAT_ID
